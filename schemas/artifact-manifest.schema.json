{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wyattowalsh/paul-graham-essay-feeds/schemas/artifact-manifest.schema.json",
  "title": "ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_id",
    "schema_version",
    "logical_updated_at",
    "artifacts",
    "catalog_sha256"
  ],
  "properties": {
    "generation_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "logical_updated_at": { "type": "string", "format": "date-time" },
    "catalog_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string" }
        }
      }
    }
  }
}
